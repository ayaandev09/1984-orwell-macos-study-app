{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orwell 1984 Codex",
  "version": "1.0.1",
  "identifier": "com.ayaanatif.orwell1984codex",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3086",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orwell 1984 Codex",
        "width": 1300,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1024,
        "minHeight": 700,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}